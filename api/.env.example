# Skapta API environment.
# Copy to .env and fill in your keys:  cp .env.example .env
#
# The ml/ package reads this file too when uvicorn is started from api/,
# so a single .env covers both the API and the RAG pipeline.

# --- Required ---------------------------------------------------------------

# LLM inference for /api/recommend -- https://console.groq.com
GROQ_API_KEY=

# Vector search over the ingested documentation -- https://app.pinecone.io
# The index must be 768 dimensions (matches all-mpnet-base-v2), cosine metric.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=skapta-docs

# --- Optional ---------------------------------------------------------------

# Comma-separated CORS allowlist. Add your deployed client origin in production.
ALLOWED_ORIGINS=http://localhost:5173

# Declared in config.py but not currently used by any code path.
OPENAI_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
